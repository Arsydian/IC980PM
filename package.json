{
  "name": "ic980-pro-max-programmer",
  "version": "1.1.0",
  "description": "Cross-platform RepeaterBook import and programming software for the Hiroyasu IC-980 Pro Max radio",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "vite --host & electron .",
    "electron:build": "tsc && vite build && electron-builder"
  },
  "keywords": [
    "ham-radio",
    "ic-980-pro-max",
    "repeaterbook",
    "codeplug",
    "chirp",
    "radio-programming",
    "hiroyasu"
  ],
  "author": "ReadFree Engineering",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
